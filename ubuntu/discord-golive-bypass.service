[Unit]
Description=Discord Go Live - WireGuard seletivo
Documentation=https://github.com/tercioLustosa/discord-golive-bypass-linux-PopOS
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/discord-golive-bypass/settings
ExecStart=/usr/local/libexec/discord-golive-bypass --config /etc/discord-golive-bypass/wireguard.conf --home ${DISCORD_HOME} --mode ${MODE}
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
